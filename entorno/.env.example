# Versions used by the local 26-27 lakehouse environment.
# Copy this file to .env if you want to override a default deliberately.
TRINO_VERSION=483
HIVE_VERSION=4.2.1
POSTGRES_VERSION=17-alpine
POSTGRES_JDBC_VERSION=42.7.13
HIVE_POSTGRES_PASSWORD=hive-local-password
TPCDS_SCALE=sf3
RUSTFS_VERSION=latest

# Session 3: independent S3-compatible data lake.
# Local lab credentials only. Do not reuse them outside this environment.
S3_ACCESS_KEY=tcdm_student
S3_SECRET_KEY=tcdm_student_secret
S3_REGION=us-east-1
S3_BUCKET=tcdm-datalake
